<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shad="https://github.com/tiny-isle/Ti.Avalonia.Shadcn"
             xmlns:views="clr-namespace:GrabAndMove.Views"
             mc:Ignorable="d"
             d:DesignWidth="560"
             d:DesignHeight="640"
             x:Class="GrabAndMove.Views.GrabAndMoveConfigPage"
             x:DataType="views:GrabAndMoveConfigViewModel">
  <UserControl.Styles>
    <!-- Keep text colors fixed; selection is border/background only (no layout or contrast flip). -->
    <Style Selector="Button.modifier-card">
      <Setter Property="Background" Value="{DynamicResource ShadCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShadBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinHeight" Value="78" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource ShadForegroundBrush}" />
    </Style>
    <Style Selector="Button.modifier-card.selected">
      <Setter Property="Background" Value="{DynamicResource ShadMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShadPrimaryBrush}" />
    </Style>
    <Style Selector="Button.modifier-card TextBlock.card-title">
      <Setter Property="Foreground" Value="{DynamicResource ShadForegroundBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.modifier-card TextBlock.card-desc">
      <Setter Property="Foreground" Value="{DynamicResource ShadMutedForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="Foreground" Value="{DynamicResource ShadForegroundBrush}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-desc">
      <Setter Property="Foreground" Value="{DynamicResource ShadMutedForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="{DynamicResource ShadForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Border.picker-host">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ShadCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShadBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.picker-host.picking">
      <Setter Property="BorderBrush" Value="{DynamicResource ShadPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource ShadMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20"
                Spacing="16">

      <Border Classes="Card"
              Padding="16,18"
              CornerRadius="16"
              Background="{DynamicResource ShadMutedBrush}">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
              <Border Width="36"
                      Height="36"
                      CornerRadius="10"
                      Background="{DynamicResource ShadPrimaryBrush}"
                      VerticalAlignment="Center">
                <LucideIcon Kind="Move"
                            Size="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ShadPrimaryForegroundBrush}" />
              </Border>
              <StackPanel VerticalAlignment="Center"
                          Spacing="2">
                <TextBlock Text="抓取移动"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ShadForegroundBrush}" />
                <TextBlock Text="按住修饰键，在窗口任意位置拖动"
                           Classes="section-desc" />
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Border Padding="10,4"
                      CornerRadius="999"
                      HorizontalAlignment="Right"
                      MinWidth="64"
                      Background="{DynamicResource ShadCardBrush}"
                      BorderBrush="{DynamicResource ShadBorderBrush}"
                      BorderThickness="1">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ShadForegroundBrush}" />
              </Border>
              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          HorizontalAlignment="Right">
                <TextBlock Text="启用"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource ShadForegroundBrush}" />
                <ToggleSwitch IsChecked="{Binding IsFeatureEnabled}"
                              OffContent=""
                              OnContent="" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,8,*"
                Opacity="{Binding GestureCardsOpacity}">
            <Border Grid.Column="0"
                    Padding="12"
                    CornerRadius="12"
                    MinHeight="64"
                    Background="{DynamicResource ShadCardBrush}"
                    BorderBrush="{DynamicResource ShadBorderBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False">
              <StackPanel Spacing="4">
                <TextBlock Text="左键 · 移动"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ShadForegroundBrush}" />
                <TextBlock Text="{Binding MoveGestureHint}"
                           Classes="section-desc" />
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    CornerRadius="12"
                    MinHeight="64"
                    Background="{DynamicResource ShadCardBrush}"
                    BorderBrush="{DynamicResource ShadBorderBrush}"
                    BorderThickness="1"
                    Opacity="{Binding ResizeHintOpacity}"
                    IsHitTestVisible="False">
              <StackPanel Spacing="4">
                <TextBlock Text="右键 · 调整大小"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ShadForegroundBrush}" />
                <TextBlock Text="{Binding ResizeGestureHint}"
                           Classes="section-desc" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Text="手势"
                   Classes="section-title" />
        <TextBlock Text="更改后立即生效，无需保存"
                   Classes="section-desc" />

        <TextBlock Text="激活修饰键"
                   Margin="0,6,0,0"
                   Classes="field-label" />
        <Grid ColumnDefinitions="*,8,*">
          <Button Grid.Column="0"
                  Classes="modifier-card"
                  Classes.selected="{Binding IsAltSelected}"
                  Command="{Binding SelectAltModifierCommand}">
            <StackPanel Spacing="4">
              <TextBlock Text="Alt"
                         Classes="card-title" />
              <TextBlock Text="默认，兼容多数应用"
                         Classes="card-desc"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Button>

          <Button Grid.Column="2"
                  Classes="modifier-card"
                  Classes.selected="{Binding IsWinSelected}"
                  Command="{Binding SelectWinModifierCommand}">
            <StackPanel Spacing="4">
              <TextBlock Text="Windows"
                         Classes="card-title" />
              <TextBlock Text="避免与菜单快捷键冲突"
                         Classes="card-desc"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Button>
        </Grid>

        <shad:SettingItemControl Title="右键调整大小"
                                 Description="按住修饰键并用右键拖动，从最近边或角调整窗口大小。">
          <shad:SettingItemControl.Icon>
            <LucideIcon Kind="Scaling" />
          </shad:SettingItemControl.Icon>
          <ToggleSwitch IsChecked="{Binding RightClickResizeEnabled}"
                        OffContent=""
                        OnContent="" />
        </shad:SettingItemControl>

        <shad:SettingItemControl Title="抑制 Alt 窗口菜单"
                                 Description="拖动或缩放后松开 Alt 时，不再弹出系统窗口菜单。选用 Windows 键时可忽略此项。"
                                 IsEnabled="{Binding IsAltSelected}"
                                 Opacity="{Binding AltMenuSettingOpacity}">
          <shad:SettingItemControl.Icon>
            <LucideIcon Kind="PanelTop" />
          </shad:SettingItemControl.Icon>
          <ToggleSwitch IsChecked="{Binding PreventAltWindowMenu}"
                        IsEnabled="{Binding IsAltSelected}"
                        OffContent=""
                        OnContent="" />
        </shad:SettingItemControl>
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="排除"
                   Classes="section-title" />
        <TextBlock Text="每行一个进程名或窗口标题关键字。也可按住右侧准星，拖到目标窗口后松开自动填入。"
                   Classes="section-desc" />

        <Grid ColumnDefinitions="*,Auto"
              Margin="0,8,0,0">
          <StackPanel Spacing="2"
                      VerticalAlignment="Center">
            <TextBlock Text="排除窗口"
                       Classes="field-label" />
            <TextBlock Text="这些进程的窗口不会被移动或调整大小"
                       Classes="section-desc" />
          </StackPanel>
          <Border x:Name="WindowExcludePicker"
                  Grid.Column="1"
                  Classes="picker-host"
                  Classes.picking="{Binding IsPickingWindowExclude}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="按住并拖到要排除的窗口，松开添加进程名"
                  PointerPressed="WindowExcludePicker_OnPointerPressed"
                  PointerMoved="WindowExcludePicker_OnPointerMoved"
                  PointerReleased="WindowExcludePicker_OnPointerReleased"
                  PointerCaptureLost="WindowExcludePicker_OnPointerCaptureLost">
            <LucideIcon Kind="Focus"
                        Size="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ShadForegroundBrush}" />
          </Border>
        </Grid>
        <TextBlock Classes="section-desc"
                   Text="{Binding WindowPickHint}"
                   IsVisible="{Binding IsPickingWindowExclude}" />
        <TextBox Text="{Binding ExcludedAppsDraft}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="72"
                 PlaceholderText="例如 notepad.exe" />

        <Grid ColumnDefinitions="*,Auto"
              Margin="0,10,0,0">
          <StackPanel Spacing="2"
                      VerticalAlignment="Center">
            <TextBlock Text="排除修饰键"
                       Classes="field-label" />
            <TextBlock Text="这些应用在前台时，不拦截 Alt / Win，交给应用自己处理"
                       Classes="section-desc" />
          </StackPanel>
          <Border x:Name="ModifierExcludePicker"
                  Grid.Column="1"
                  Classes="picker-host"
                  Classes.picking="{Binding IsPickingModifierExclude}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="按住并拖到目标窗口，松开添加进程名"
                  PointerPressed="ModifierExcludePicker_OnPointerPressed"
                  PointerMoved="ModifierExcludePicker_OnPointerMoved"
                  PointerReleased="ModifierExcludePicker_OnPointerReleased"
                  PointerCaptureLost="ModifierExcludePicker_OnPointerCaptureLost">
            <LucideIcon Kind="Focus"
                        Size="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ShadForegroundBrush}" />
          </Border>
        </Grid>
        <TextBlock Classes="section-desc"
                   Text="{Binding ModifierPickHint}"
                   IsVisible="{Binding IsPickingModifierExclude}" />
        <TextBox Text="{Binding ModifierExcludedAppsDraft}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="72"
                 PlaceholderText="例如 game.exe" />

        <Grid ColumnDefinitions="*,Auto"
              Margin="0,8,0,4">
          <TextBlock VerticalAlignment="Center"
                     Classes="section-desc"
                     Text="有未保存的更改，请点击应用"
                     IsVisible="{Binding HasUnappliedExcludeChanges}" />
          <Button Grid.Column="1"
                  Content="应用排除列表"
                  Command="{Binding ApplyExclusionsCommand}" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
